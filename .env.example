# Copy to .env and edit.

# Raw URL of pack/pack.toml in your GitHub repo (repo must be public, or use a
# token-free host such as GitHub Pages).
PACK_URL=https://raw.githubusercontent.com/OWNER/REPO/main/pack/pack.toml

# Must match pack/pack.toml [versions] minecraft
MC_VERSION=1.21.1

MC_IMAGE_TAG=java25
MC_MEMORY=4G
MC_MOTD=Holiday-ish server
MC_MAX_PLAYERS=10
MC_DIFFICULTY=normal
MC_WHITELIST=false
# Comma separated usernames. The list is rewritten from these on every start,
# so edit here (not in-game) if you want changes to stick.
MC_WHITE_LIST=
MC_OPS=

# Any other itzg/minecraft-server setting can be added here too, e.g.:
# SEED=12345
# VIEW_DISTANCE=12
# PVP=true
# SPAWN_PROTECTION=0
# MODE=survival
RCON_PASSWORD=change-me-to-something-long
TZ=Europe/Berlin

# How often to check the repo for changes, and the in-game warning before restart
UPDATE_POLL_SECONDS=300
UPDATE_WARN_SECONDS=60

# Copy to .env and edit.

# Pack built by this repo's GitHub Pages deployment (Settings -> Pages -> Source: GitHub Actions)
PACK_URL=https://zonlykroks.github.io/fabric-ish-server/pack.toml

# Raw URL of the whitelist file in YOUR repo; applied live every poll, no restart.
WHITELIST_URL=https://raw.githubusercontent.com/zOnlyKroks/fabric-ish-server/main/server-config/whitelist.json
MC_WHITELIST=true

# Same for ops.json (applied live with op/deop)
OPS_URL=https://raw.githubusercontent.com/zOnlyKroks/fabric-ish-server/main/server-config/ops.json

# Must match the upstream pack (check its pack.toml [versions])
MC_VERSION=26.3
FABRIC_LOADER_VERSION=0.20.1
MC_IMAGE_TAG=java25-graalvm

MC_MEMORY=4G
# Optimized JVM flags (MeowIce). Set to false for the JVM defaults.
USE_MEOWICE_FLAGS=true
MC_MOTD=Holiday-ish server
MC_MAX_PLAYERS=10
MC_DIFFICULTY=normal
# Comma separated usernames
MC_OPS=

# Any other itzg/minecraft-server setting can be added here too, e.g.:
# SEED=12345
# VIEW_DISTANCE=12
# PVP=true

TZ=Europe/Berlin

# Repo check interval, in-game warning before a restart, snapshots to keep
UPDATE_POLL_SECONDS=300
UPDATE_WARN_SECONDS=60
BACKUP_KEEP=5

# --- Optional HTTPS for the BlueMap web map (docker compose --profile https up -d) ---
# A domain whose DNS record points at this server; ports 80 and 443 must be open.
# MAP_DOMAIN=map.example.com
# With HTTPS on, stop exposing the plain-HTTP port to the internet:
# BLUEMAP_BIND=127.0.0.1

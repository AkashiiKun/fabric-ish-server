{
	"schemaVersion": 1,
	"id": "fabric-ish",
	"version": "${version}",
	"name": "FabricIsh",
	"description": "Server-side and client-side code for the Fabric-ish pack.",
	"authors": [
		"zOnlyKroks"
	],
	"contact": {
		"homepage": "https://github.com/zOnlyKroks/fabric-ish-server",
		"sources": "https://github.com/zOnlyKroks/fabric-ish-server"
	},
	"license": "CC0-1.0",
	"icon": "assets/fabric-ish/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"fabricish.FabricIshMod"
		],
		"client": [
      "fabricish.client.FabricIshModClient"
		],
    "fabric-datagen": [
      "fabricish.DataGenEntrypoint"
    ]
	},
	"mixins": [
    "fabric-ish.mixins.json",
		{
			"config": "fabric-ish.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
